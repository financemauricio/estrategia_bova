# Copy this file to .env and fill in the value.
# On Streamlit Cloud, add this key in the Secrets panel (TOML format).

# Cadeia de cotações / corretor de barra parcial do yfinance (grátis em https://brapi.dev)
# Opcional: sem ele o app usa apenas yfinance e descarta a barra corrompida do dia.
BRAPI_TOKEN=seu_token_brapi

# Alertas por e-mail (usados pelo notificar.py / GitHub Actions).
# No Gmail, use uma "Senha de app" de 16 caracteres, não a senha normal.
EMAIL_REMETENTE=seu_email@gmail.com
EMAIL_SENHA=sua_senha_de_app
EMAIL_DESTINATARIO=destino@exemplo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Opcional: link do painel no rodapé do e-mail.
APP_URL=
